# Backend API ünvanı.
# Boş buraxılarsa, Vite dev-proxy vasitəsilə /api -> http://localhost:9090 istifadə olunur.
# Production-da tam ünvan verin, məsələn:
# VITE_API_URL=https://atb.hopandgo.az/api
VITE_API_URL=

# Dev-proxy-nin hədəfi (yalnız `npm run dev` üçün). Default: http://localhost:9090
VITE_PROXY_TARGET=
